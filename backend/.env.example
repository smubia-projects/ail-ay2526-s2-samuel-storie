# OpenRouter API key for LLM and image generation
OPENROUTER_API_KEY=sk-or-v1-xxx

# OpenRouter model names (defaults shown). The image model must support
# image output via chat completions (modalities: ["image", "text"]).
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# CORS origins (comma-separated, set to Vercel URL after deploy)
CORS_ORIGINS=http://localhost:5173

# Upstash Redis for rate limiting (optional — rate limiting disabled if unset)
# Use the names from the Upstash dashboard (REST_); the short names also work.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx

# Rate limit config (optional — defaults shown). Per IP, per action, per window.
# RATE_LIMIT_GENERATE_MAX=1     # storybook generations
# RATE_LIMIT_IMAGE_MAX=2        # image regenerations
# RATE_LIMIT_TEXT_MAX=5         # text regenerations (cheap, higher default)
# RATE_LIMIT_WINDOW_SECONDS=432000  # 5 days
